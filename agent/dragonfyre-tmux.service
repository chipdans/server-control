[Unit]
Description=Dragonfyre Minecraft Server (direct tmux console)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=minecraft
Group=minecraft
WorkingDirectory=/opt/minecraft/dragonfyre
RuntimeDirectory=server-control-minecraft
RuntimeDirectoryMode=0750
ExecStart=/usr/bin/python3 /opt/server-control/current/minecraft_tmux_runner.py --session dragonfyre --workdir /opt/minecraft/dragonfyre --exit-file /run/server-control-minecraft/dragonfyre.exit -- /bin/bash /opt/minecraft/dragonfyre/start.sh
Restart=on-failure
RestartSec=10
TimeoutStopSec=180
KillMode=mixed
LimitNOFILE=65536
UMask=0007
NoNewPrivileges=true
PrivateTmp=false
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/opt/minecraft /run/server-control-minecraft

[Install]
WantedBy=multi-user.target
