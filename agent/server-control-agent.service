[Unit]
Description=Server Control Agent
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=servercontrol
Group=servercontrol
ExecStart=/usr/bin/python3 /opt/server-control/server_control_agent.py --config /etc/server-control/agent-config.json
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/opt/minecraft/dragonfyre/logs

[Install]
WantedBy=multi-user.target
