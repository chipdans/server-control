{
  "hub_url": "https://server-control-hub.YOUR-SUBDOMAIN.workers.dev",
  "agent_api_key": "REPLACE_WITH_THE_SAME_AGENT_API_KEY_AS_IN_CLOUDFLARE",
  "poll_seconds": 3,
  "heartbeat_seconds": 15,
  "request_timeout_seconds": 20,
  "state_directory": "/var/lib/server-control",
  "minecraft_root": "/opt/minecraft",
  "backup_root": "/srv/server-control/backups",
  "max_job_workers": 2,
  "allowed_services": [
    "server-control-agent.service",
    "dragonfyre.service"
  ],
  "agent_update_command": [
    "sudo",
    "-n",
    "/usr/local/sbin/server-control-agent-update"
  ],
  "minecraft": {
    "service": "dragonfyre.service",
    "directory": "/opt/minecraft/dragonfyre",
    "log_file": "/opt/minecraft/dragonfyre/logs/latest.log",
    "console_mode": "rcon",
    "rcon_host": "127.0.0.1",
    "rcon_port": 25575,
    "rcon_password": "REPLACE_WITH_A_LONG_RCON_PASSWORD",
    "tmux_session": "dragonfyre"
  },
  "commands": {
    "allow_shell_commands": [
      "uptime",
      "free -h",
      "df -h",
      "lsblk"
    ],
    "backup_command": "/usr/local/bin/minecraft-backup.sh"
  }
}
