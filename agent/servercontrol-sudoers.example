# Install as /etc/sudoers.d/servercontrol with mode 0440 after checking paths.
# It deliberately grants only the operations used by the agent.  If your
# Minecraft service has a different name, replace every occurrence below.
Cmnd_Alias SERVER_CONTROL_MINECRAFT = \
  /usr/bin/systemctl start dragonfyre.service, \
  /usr/bin/systemctl stop dragonfyre.service, \
  /usr/bin/systemctl restart dragonfyre.service
Cmnd_Alias SERVER_CONTROL_POWER = /usr/bin/systemctl reboot, /usr/bin/systemctl poweroff
servercontrol ALL=(root) NOPASSWD: SERVER_CONTROL_MINECRAFT, SERVER_CONTROL_POWER
